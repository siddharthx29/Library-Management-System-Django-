# ==============================================================================
# Athena Academic Library Platform - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure with appropriate values.
# NEVER commit your actual .env file or production secrets to source control.

# Core Application Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration (Defaults to SQLite for local development)
# DATABASE_URL=postgres://user:password@localhost:5432/library_db

# Security & Session Settings
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Fine & Loan Policy Settings
DAILY_OVERDUE_FINE=0.50
DEFAULT_LOAN_PERIOD_DAYS=14
MAX_LOAN_RENEWALS=2
